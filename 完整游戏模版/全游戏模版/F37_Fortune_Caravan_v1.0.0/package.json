  "scripts": {
    "test": "npm run test:math && npm run test:apple-auth && npm run test:rank && npm run test:layout && npm run test:rules && npm run test:language && npm run test:signature && npm run test:core && npm run test:cabinets && npm run test:primary && npm run test:guardians && npm run test:audio && npm run test:audio:recordings && npm run test:audio:festive && npm run test:award && npm run test:life && npm run test:reel-presentation && npm run test:text-layout && npm run test:caravan && npm run test:guardian-renderer && npm run test:lobby-details && npm run test:page-arrival",
    "test:layout": "node --import tsx tools/layout-test.ts",
    "test:math": "node --import tsx tools/math-test.ts",
    "test:apple-auth": "node --import tsx tools/apple-auth-test.ts",
    "test:rank": "node --import tsx tools/rank-test.ts",
    "test:rtp": "node --import tsx tools/rtp-simulation.ts 100000",
    "release:audit": "node --import tsx tools/release-audit.ts",
    "typecheck:math": "tsc -p tsconfig.math.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "server:dev": "node --import tsx server/ProductionServer.ts",
    "server:production": "NODE_ENV=production node --import tsx server/PostgresProductionServer.ts",
    "test:rules": "node --import tsx tools/rules-test.ts",
    "test:language": "node --import tsx tools/language-test.ts",
    "test:signature": "node --import tsx tools/signature-test.ts",
    "test:core": "node --import tsx tools/core-test.ts",
    "test:cabinets": "node --import tsx tools/cabinet-test.ts",
    "test:primary": "node --import tsx tools/primary-test.ts",
    "test:guardians": "node --import tsx tools/guardian-test.ts",
    "test:audio": "node --import tsx tools/audio-test.ts",
    "test:award": "node --import tsx tools/award-test.ts",
    "test:audio:recordings": "node --import tsx tools/audio-recording-test.ts",
    "test:life": "node --import tsx tools/treasury-life-test.ts",
    "test:audio:festive": "node --import tsx tools/festive-audio-test.ts",
    "test:reel-presentation": "node --import tsx tools/reel-presentation-test.ts",
    "test:text-layout": "node --import tsx tools/text-layout-test.ts",
    "test:caravan": "node --import tsx tools/caravan-test.ts",
    "test:guardian-renderer": "node --import tsx tools/guardian-renderer-test.ts",
    "test:lobby-details": "node --import tsx tools/lobby-detail-test.ts",
    "test:page-arrival": "node --import tsx tools/page-arrival-test.ts"
