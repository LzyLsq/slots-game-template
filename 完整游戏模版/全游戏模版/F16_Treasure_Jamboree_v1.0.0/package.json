{
  "name": "f16-treasure-jamboree",
  "uuid": "76f0ee8e-c40d-4cf8-9f10-20c6576a028a",
  "version": "1.0.0",
  "description": "F16 Treasure Jamboree — four playful treasure games in a joyful golden carnival",
  "creator": {
    "version": "3.8.8"
  },
  "scripts": {
    "test": "npm run test:math && npm run test:economy && npm run test:apple-auth && npm run test:rank && npm run test:layout && npm run test:rules && npm run test:language && npm run test:motion && npm run test:press",
    "test:motion": "node --import tsx tools/reel-motion-test.ts",
    "test:press": "node --import tsx tools/press-test.ts",
    "test:economy": "node --import tsx tools/economy-test.ts",
    "test:layout": "node --import tsx tools/layout-test.ts",
    "test:math": "node --import tsx tools/math-test.ts",
    "test:apple-auth": "node --import tsx tools/apple-auth-test.ts",
    "test:rank": "node --import tsx tools/rank-test.ts",
    "test:rtp": "node --import tsx tools/rtp-simulation.ts 100000",
    "release:audit": "node --import tsx tools/release-audit.ts",
    "typecheck:math": "tsc -p tsconfig.math.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "server:dev": "node --import tsx server/ProductionServer.ts",
    "server:production": "NODE_ENV=production node --import tsx server/PostgresProductionServer.ts",
    "test:rules": "node --import tsx tools/rules-test.ts",
    "test:language": "node --import tsx tools/language-test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "8.15.5",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "pg": "8.16.3"
  }
}
