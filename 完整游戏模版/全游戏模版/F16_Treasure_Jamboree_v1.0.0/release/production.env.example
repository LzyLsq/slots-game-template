# Public deployment configuration. Copy to the secret manager; do not commit real values.
NODE_ENV=production
PORT=4191
HOST=0.0.0.0
JAMBOREE_ALLOWED_ORIGIN=https://REPLACE_WITH_PUBLIC_DOMAIN
JAMBOREE_WEB_ROOT=/srv/treasure-jamboree/build/web-mobile
DATABASE_URL=postgresql://REPLACE_WITH_DATABASE_SECRET
JAMBOREE_DB_SSL=require
JAMBOREE_DB_POOL_SIZE=12
JAMBOREE_TRUST_PROXY=1
JAMBOREE_SESSION_PEPPER=REPLACE_WITH_32_PLUS_RANDOM_SECRET
JAMBOREE_APPLE_BUNDLE_ID=REPLACE_WITH_BUNDLE_ID
JAMBOREE_APPLE_ENVIRONMENT=Production
JAMBOREE_APPLE_ROOT_CA_PATHS=/run/secrets/AppleRootCA-G3.cer
JAMBOREE_IAP_PRODUCTS={"REPLACE_PRODUCT_SPARK":10000,"REPLACE_PRODUCT_ORBIT":55000,"REPLACE_PRODUCT_NOVA":138000,"REPLACE_PRODUCT_GALAXY":360000}
