CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        cabinet: { value: [0.0, 0.32, 0.0, 0.0] }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;

    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;
  #include <builtin/uniforms/cc-global>
  uniform CabinetParams { vec4 cabinet; };

  #if USE_TEXTURE
    in vec2 uv0;
    #pragma builtin(local)
    layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  #endif

  vec4 frag () {
    vec4 o = vec4(1, 1, 1, 1);

    #if USE_TEXTURE
      o *= CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
      #if IS_GRAY
        float gray  = 0.2126 * o.r + 0.7152 * o.g + 0.0722 * o.b;
        o.r = o.g = o.b = gray;
      #endif
    #endif

    // Light follows the scene's warm metal only; deep velvet and portraits stay quiet.
    float time = cc_time.x;
    float gold = smoothstep(0.055,0.24,o.r-o.b) * smoothstep(0.42,0.83,o.r);
    float column = exp(-pow((uv0.x-.11)/.024,2.0)) + exp(-pow((uv0.x-.50)/.020,2.0)) + exp(-pow((uv0.x-.90)/.024,2.0));
    float cornice = exp(-pow((uv0.y-.42)/.026,2.0)) + exp(-pow((uv0.y-.725)/.025,2.0));
    float position = -.18 + mod(time*.095,1.38);
    float sweep = exp(-pow((uv0.x+uv0.y*.22-position)/.085,2.0));
    float glimmer = .5+.5*sin(time*.65+uv0.y*18.0);
    o.rgb += vec3(1.0,.78,.42) * gold * (cornice*sweep*.62 + column*glimmer*.28);
    // Reflected light travels around the four carved openings, not across their text.
    float archSides = exp(-pow((uv0.x-.159)/.014,2.0)) + exp(-pow((uv0.x-.435)/.014,2.0))
                    + exp(-pow((uv0.x-.563)/.014,2.0)) + exp(-pow((uv0.x-.839)/.014,2.0));
    float upperBoxes = smoothstep(.19,.23,uv0.y)*(1.0-smoothstep(.37,.40,uv0.y));
    float lowerBoxes = smoothstep(.50,.54,uv0.y)*(1.0-smoothstep(.68,.71,uv0.y));
    float drift = .5+.5*sin(time*.83-uv0.y*13.0+uv0.x*8.0);
    float floor = smoothstep(.81,.91,uv0.y);
    float reflection = exp(-pow((uv0.x-(.5+.28*sin(time*.43)))/.16,2.0));
    o.rgb += vec3(1.0,.83,.56)*gold*(archSides*(upperBoxes+lowerBoxes)*drift*.48+floor*reflection*.28);
    // A moving pool of reflected light reads through both shade and highlight.
    float architecture = clamp(column+cornice+archSides*(upperBoxes+lowerBoxes),0.0,1.0);
    float broadPass = exp(-pow((uv0.x-(.5+.48*sin(time*.75)))/.12,2.0));
    o.rgb *= 1.0 + architecture*gold*(broadPass*.20-.065);
    // Broad satin reflection, with a soft leading edge and a longer falloff.
    float glossPhase = mod(time,8.5)/8.5;
    float glossAxis = uv0.x+uv0.y*.32-(-.40+glossPhase*2.05);
    float glossBand = exp(-pow(glossAxis/.075,2.0))*.46 + exp(-pow((glossAxis+.09)/.17,2.0))*.16;
    float sculpted = clamp(architecture+floor*.55+(1.0-smoothstep(.10,.18,uv0.y))*.65,0.0,1.0);
    float glossMask = gold*sculpted;
    o.rgb = mix(o.rgb,vec3(1.0,.95,.78),clamp(glossBand*glossMask,0.0,.52));
    o *= color;
    ALPHA_TEST(o);
    return o;
  }
}%
