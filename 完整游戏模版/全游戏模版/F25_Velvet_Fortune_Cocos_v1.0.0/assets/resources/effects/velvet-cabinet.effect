CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        cabinet: { value: [0.0, 0.32, 0.0, 0.0] }
        response: { value: [0.0, 0.0, 0.0, 0.0] }
        frameUV: { value: [0, 0, 1, 1] }
        motionClock: { value: [0, 0, 1, 0] }
        region0: { value: [0, 0, 0, 0] }
        region1: { value: [0, 0, 0, 0] }
        region2: { value: [0, 0, 0, 0] }
        region3: { value: [0, 0, 0, 0] }
        pose0: { value: [0, 0, 0, 0] }
        pose1: { value: [0, 0, 0, 0] }
        pose2: { value: [0, 0, 0, 0] }
        pose3: { value: [0, 0, 0, 0] }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;

    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;
  #include <builtin/uniforms/cc-global>
  uniform CabinetParams { vec4 cabinet; vec4 response; };

  #if USE_TEXTURE
    in vec2 uv0;
    #pragma builtin(local)
    layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  #endif

  uniform PaintedMotion {
    vec4 frameUV;
    vec4 motionClock;
    vec4 region0;vec4 region1;vec4 region2;vec4 region3;
    vec4 pose0;vec4 pose1;vec4 pose2;vec4 pose3;
  };
  vec2 drift(vec2 uv,vec4 r,vec4 pose) {
    if(r.z<=0.0||r.w<=0.0)return vec2(0);
    vec2 d=abs(uv-r.xy)/r.zw;
    float weight=(1.0-smoothstep(0.68,1.0,d.x))*(1.0-smoothstep(0.64,1.0,d.y));
    float aspect=max(0.1,motionClock.z);
    vec2 pivot=r.xy+vec2(0,r.w*0.54);
    vec2 v=(uv-pivot)*vec2(aspect,1);
    vec2 delta=vec2(pose.y*v.x-pose.x*v.y,pose.x*v.x+pose.y*v.y)/vec2(aspect,1);
    delta.y-=pose.z;
    return delta*weight*motionClock.y;
  }

  vec4 frag () {
    vec4 o = vec4(1, 1, 1, 1);

    #if USE_TEXTURE
      // Only the upper side drapery breathes; character motion is localized above the anchored screen and controls.
      vec2 local=(uv0-frameUV.xy)/frameUV.zw;
      vec2 moved=local+drift(local,region0,pose0)+drift(local,region1,pose1)+drift(local,region2,pose2)+drift(local,region3,pose3);
      vec2 sampleUV=frameUV.xy+clamp(moved,vec2(0.0001),vec2(0.9999))*frameUV.zw;
      vec4 original = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
      float velvet = smoothstep(0.10, 0.28, original.r - original.g) * (1.0 - smoothstep(0.32, 0.55, original.g));
      float upper = smoothstep(0.025, 0.07, uv0.y) * (1.0 - smoothstep(0.23, 0.32, uv0.y));
      float leftCloth = exp(-pow((uv0.x - 0.065) / 0.045, 2.0));
      float rightCloth = exp(-pow((uv0.x - 0.935) / 0.045, 2.0));
      sampleUV.x += velvet * upper * (leftCloth - rightCloth) * 0.0032 * sin(cc_time.x * 1.05 + uv0.y * 19.0 + cabinet.w);
      o *= CCSampleWithAlphaSeparated(cc_spriteTexture, sampleUV);
      #if IS_GRAY
        float gray  = 0.2126 * o.r + 0.7152 * o.g + 0.0722 * o.b;
        o.r = o.g = o.b = gray;
      #endif
    #endif

    // Reflections follow the actual brass sides and rails, never the entire scene.
    float time = cc_time.x;
    float sides = exp(-pow((uv0.x - 0.065) / 0.047, 2.0)) + exp(-pow((uv0.x - 0.935) / 0.047, 2.0));
    float movingY = 0.1 + mod(time * 0.095 + cabinet.w * 0.21, 0.86);
    float sweep = exp(-pow((uv0.y - movingY) / 0.065, 2.0));
    float topRail = exp(-pow((uv0.y - cabinet.x + 0.012) / 0.009, 2.0));
    float bottomRail = exp(-pow((uv0.y - cabinet.x - cabinet.y - 0.012) / 0.012, 2.0));
    float crossing = exp(-pow((uv0.x - (-0.2 + mod(time * 0.17 + cabinet.w * 0.27, 1.5))) / 0.12, 2.0));
    float coins = exp(-pow((uv0.y - (cabinet.x - 0.145)) / 0.035, 2.0));
    float shimmer = pow(max(0.0, sin(uv0.x * 30.0 - time * 1.5)), 10.0);
    float bright = smoothstep(0.30, 0.88, max(o.r, max(o.g, o.b)));
    float gold = smoothstep(0.015, 0.20, o.r - o.b);
    float energy = sides * sweep * 0.43 + (topRail + bottomRail) * crossing * 0.43 + coins * shimmer * 0.23;
    energy += (topRail + bottomRail) * response.x * (0.10 + 0.12 * crossing) + sides * response.x * 0.07;
    // Broad changing illumination belongs to the original ornament pixels, not an overlay card.
    float ornament = exp(-pow((uv0.y - (cabinet.x - 0.19)) / 0.062, 2.0));
    float sideObjects = exp(-pow((uv0.x - 0.18) / 0.12, 2.0)) + exp(-pow((uv0.x - 0.82) / 0.12, 2.0));
    float passing = exp(-pow((uv0.x - (0.5 + 0.43 * sin(time * 0.62 + cabinet.w))) / 0.18, 2.0));
    float pearl = 1.0 - smoothstep(0.0, 0.35, abs(cabinet.w - 2.0));
    energy += ornament * sideObjects * passing * (0.22 + pearl * 0.10);
    vec3 warmth = mix(vec3(1.0, 0.82, 0.48),vec3(0.79,0.91,1.0),pearl * 0.40);
    // Exterior columns and plinth catch slow, staggered reflected stage light.
    float exterior = exp(-pow((uv0.x-.035)/.036,2.0)) + exp(-pow((uv0.x-.965)/.036,2.0));
    float lowerBody = smoothstep(cabinet.z+.10,cabinet.z+.17,uv0.y);
    float exteriorWave = .5+.5*sin(time*.73-uv0.y*10.0+uv0.x*4.0+cabinet.w);
    float plinth = exp(-pow((uv0.y-.935)/.043,2.0));
    float floorSweep = exp(-pow((uv0.x-(.5+.36*sin(time*.46+cabinet.w)))/.17,2.0));
    energy += exterior*(.05+.38*exteriorWave) + lowerBody*plinth*floorSweep*.36;
    o.rgb *= 1.0 + exterior * gold * (exteriorWave*.22-.09);
    o.rgb += warmth * energy * bright * max(gold,pearl * 0.45);
    // A continuous broad reflection travels on metal, leaving the reel opening untouched.
    float glossPhase = mod(time+cabinet.w*1.25,7.8)/7.8;
    float glossAxis = uv0.x+uv0.y*.30-(-.42+glossPhase*2.08);
    float glossBand = exp(-pow(glossAxis/.072,2.0))*.50 + exp(-pow((glossAxis+.085)/.15,2.0))*.17;
    float metalShape = clamp(sides+exterior+topRail+bottomRail+coins*sideObjects+lowerBody*.45,0.0,1.0);
    float glossMask = bright*max(gold,pearl*.40)*metalShape;
    o.rgb = mix(o.rgb,mix(vec3(1.0,.94,.75),vec3(.94,.97,1.0),pearl*.65),clamp(glossBand*glossMask,0.0,.55));
    o *= color;
    ALPHA_TEST(o);
    return o;
  }
}%
