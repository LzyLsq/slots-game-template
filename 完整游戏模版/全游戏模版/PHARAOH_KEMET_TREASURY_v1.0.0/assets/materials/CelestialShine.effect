CCEffect %{
  techniques:
  - passes:
    - vert: shine-vs:vert
      frag: shine-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.01 }
        shineColor: { value: [0.35, 0.9, 1.0, 1.0], editor: { type: color } }
        shineParams: { value: [0.35, 0.16, 0.72, 1.0] }
}%

CCProgram shine-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec4 color;
  out vec2 uv0;
  vec4 vert () {
    vec4 position = vec4(a_position, 1.0);
    #if USE_LOCAL
      position = cc_matWorld * position;
    #endif
    uv0 = a_texCoord;
    color = a_color;
    return cc_matViewProj * position;
  }
}%

CCProgram shine-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>
  in vec4 color;
  in vec2 uv0;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  uniform ShineConstants {
    vec4 shineColor;
    vec4 shineParams;
  };
  vec4 frag () {
    vec4 base = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0) * color;
    float speed = shineParams.x;
    float width = max(0.01, shineParams.y);
    float angle = shineParams.z;
    float brightness = shineParams.w;
    vec2 direction = vec2(cos(angle), sin(angle));
    float phase = fract(cc_time.x * speed) * 2.2 - 0.6;
    float coordinate = dot(uv0, direction);
    float band = smoothstep(width, 0.0, abs(coordinate - phase));
    vec3 result = base.rgb + shineColor.rgb * band * brightness * base.a;
    vec4 outputColor = vec4(result, base.a);
    ALPHA_TEST(outputColor);
    return outputColor;
  }
}%
