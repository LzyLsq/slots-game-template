# F24 isolated deployment. TEMPLATE ONLY; all REPLACE values block production.
# Keep the registered Bundle ID equal in Xcode, App Store Connect and verifier.
NODE_ENV=production
PORT=5425
HOST=0.0.0.0
CSW_ALLOWED_ORIGIN=https://REPLACE_WITH_F24_PUBLIC_DOMAIN
CSW_WEB_ROOT=/srv/aurum-atelier/build/web-mobile
DATABASE_URL=postgresql://REPLACE_WITH_F24_DATABASE_SECRET
CSW_DB_SSL=require
CSW_DB_POOL_SIZE=12
# Set to 1 ONLY behind a trusted proxy that replaces X-Forwarded-For.
CSW_TRUST_PROXY=0
CSW_SESSION_PEPPER=REPLACE_WITH_32_PLUS_RANDOM_SECRET
CSW_APPLE_BUNDLE_ID=com.publisher.aurumatelier
CSW_APPLE_ENVIRONMENT=Production
CSW_APPLE_ROOT_CA_PATHS=/run/secrets/AppleRootCA-G3.cer
# Total delivered coins = base credits + bonus, matches STORE_PRODUCTS.
CSW_IAP_PRODUCTS={"com.publisher.aurumatelier.coins.apprentice":20000,"com.publisher.aurumatelier.coins.artisan":110000,"com.publisher.aurumatelier.coins.master":240000,"com.publisher.aurumatelier.coins.patron":520000}
