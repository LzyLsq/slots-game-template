CCEffect %{
  techniques:
  - passes:
    - vert: ripple-vs:vert
      frag: ripple-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.01 }
        rippleParams: { value: [0.006, 18.0, 0.35, 0.0] }
        tintColor: { value: [0.82, 0.95, 1.0, 1.0], editor: { type: color } }
}%

CCProgram ripple-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec4 color;
  out vec2 uv0;
  vec4 vert () {
    vec4 position = vec4(a_position, 1.0);
    #if USE_LOCAL
      position = cc_matWorld * position;
    #endif
    uv0 = a_texCoord;
    color = a_color;
    return cc_matViewProj * position;
  }
}%

CCProgram ripple-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>
  in vec4 color;
  in vec2 uv0;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  uniform RippleConstants {
    vec4 rippleParams;
    vec4 tintColor;
  };
  vec4 frag () {
    vec2 centered = uv0 - vec2(0.5);
    float distanceFromCenter = length(centered);
    float wave = sin(distanceFromCenter * rippleParams.y - cc_time.x * rippleParams.z * 20.0);
    float envelope = smoothstep(0.75, 0.05, distanceFromCenter);
    vec2 offset = normalize(centered + vec2(0.0001)) * wave * rippleParams.x * envelope;
    vec4 outputColor = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 + offset) * color * tintColor;
    ALPHA_TEST(outputColor);
    return outputColor;
  }
}%
