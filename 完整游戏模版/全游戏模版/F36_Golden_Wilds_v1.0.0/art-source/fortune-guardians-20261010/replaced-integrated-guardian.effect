CCEffect %{
  techniques:
  - passes:
    - vert: guardian-vs:vert
      frag: guardian-fs:frag
      depthStencilState: { depthTest: false, depthWrite: false }
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState: { cullMode: none }
      properties:
        alphaThreshold: { value: 0.5 }
        guardianRegion: { value: [0.5, 0.7, 0.18, 0.07] }
        guardianMotion: { value: [0, 0, 0, 0] }
}%
CCProgram guardian-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec4 color;
  out vec2 uv0;
  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    uv0 = a_texCoord;
    color = a_color;
    return cc_matViewProj * pos;
  }
}%
CCProgram guardian-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>
  in vec4 color;
  in vec2 uv0;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  uniform Guardian {
    vec4 guardianRegion;
    vec4 guardianMotion;
  };
  vec4 frag () {
    vec2 d = (uv0 - guardianRegion.xy) / guardianRegion.zw;
    float weight = 1.0 - smoothstep(0.25, 1.0, length(d));
    float t = guardianMotion.x;
    float amplitude = guardianMotion.w;
    float joy = guardianMotion.y;
    float watch = guardianMotion.z;
    float breath = sin(t * 1.3);
    vec2 sway = vec2(sin(t * 0.85) * (0.0038 + joy * 0.0018), breath * 0.0022);
    sway.y += sin(t * 3.2) * joy * 0.0017;
    sway.x += sin(t * 1.8) * watch * 0.0007;
    vec2 uv = uv0 + amplitude * weight * (sway + (uv0 - guardianRegion.xy) * breath * 0.017);
    vec4 o = CCSampleWithAlphaSeparated(cc_spriteTexture, uv) * color;
    ALPHA_TEST(o);
    return o;
  }
}%
