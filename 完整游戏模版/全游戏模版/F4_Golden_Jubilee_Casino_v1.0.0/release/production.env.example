# Public deployment configuration. Copy to the secret manager; do not commit real values.
NODE_ENV=production
PORT=4191
HOST=0.0.0.0
CSW_ALLOWED_ORIGIN=https://REPLACE_WITH_PUBLIC_DOMAIN
CSW_WEB_ROOT=/srv/golden-jubilee/build/web-mobile
DATABASE_URL=postgresql://REPLACE_WITH_DATABASE_SECRET
CSW_DB_SSL=require
CSW_DB_POOL_SIZE=12
CSW_TRUST_PROXY=1
